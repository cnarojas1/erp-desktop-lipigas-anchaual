{
  "$schema": "https://tauri.app/schema/tauri.config.json",
  "build": {
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build"
  },
  "tauri": {
    "identifier": "cl.digitalizaplus.lipigas-anchaual",
    "updater": {
      "active": true,
      "endpoints": ["https://github.com/nicolasrojas/erp-desktop/releases/download/v1.0.0/update.json"]
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "icon": [
        "src-tauri/icons/32x32.png",
        "src-tauri/icons/128x128.png",
        "src-tauri/icons/180x180.png",
        "src-tauri/icons/512x525.png"
      ],
      "resources": ["sqlite/schema.sql"]
    }
  },
  "allowlist": {
    "all": false,
    "fs": { "all": true },
    "http": { "all": true },
    "dialog": { "all": true },
    "updater": { "all": true }
  }
}